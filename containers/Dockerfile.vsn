# Dockerfile for R 4.4.2 + Python environment
FROM r-base:4.4.2

# System dependencies
RUN apt-get update && apt-get install -y \
    python3 python3-venv python3-dev \
    libcurl4-openssl-dev libssl-dev libxml2-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python3 -m venv /opt/venv

# Use venv and install Python packages
RUN /opt/venv/bin/pip install --upgrade pip
RUN /opt/venv/bin/pip install numpy pandas matplotlib seaborn scikit-learn open_nipals

# Make venv default
ENV PATH="/opt/venv/bin:$PATH"

# Install R packages
RUN R -e "install.packages('BiocManager', repos='https://cloud.r-project.org')" \
 && R -e "BiocManager::install('vsn', ask=FALSE, update=FALSE)" \
 && R -e "install.packages('optparse', repos='https://cloud.r-project.org')"


WORKDIR /app