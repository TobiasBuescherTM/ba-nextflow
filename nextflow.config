//export NXF_SYNTAX_PARSER=v2

docker.enabled = false //allow the use of docker images 

outputDir = "./results" //set output dir 


//echo 'export NXF_SYNTAX_PARSER=v2' >> ~/.bashrc


params {
    //init
    input_data = "./input_data/input.csv"
    file_name = "test"
    //replicate_zero  
    quantile = true // if false all missing values will be treated with replicate zero strategie
    //cv_icc
    cv_cutoff = 0.3  // set between 0.2 to 0.3
    icc_cutoff = 0.65  // 0.4 = poor , 0.4 - 0.75 = fair . 0.75 and above = excellent










    //scripts
    innit_script = "./modules/innit/innit.py"
    replicate_zero_script = "./modules/replicate_zero/replicate_zero.py"
    missing_percent_script = "./modules/80%/80%.py"
    qcomics_script = "./modules/qcomics/qcomics.py"
    cv_icc_script = "./modules/cv_icc/cv_icc.py"
    imputation_script = "./modules/imputation/imputation.r"
    imputation_start_script = "./modules/imputation/start.py"
    imputation_end_script = "./modules/imputation/end.py"
    vsn_script = "./modules/vsn/vsn.r"
    vsn_start_script = "./modules/vsn/start.py"
    vsn_end_script = "./modules/vsn/end.py"

}

profiles {
    
    test{

        docker.enabled = true
        outputDir = "./results"

        params {
            //init
            input_data = "./input_data/input.csv"
            file_name = "test"
            //replicate_zero  
            quantile = true // if false all missing values will be treated with replicate zero strategie
            //cv_icc
            cv_cutoff = 0.3  // set between 0.2 to 0.3
            icc_cutoff = 0.65  // 0.4 = poor , 0.4 - 0.75 = fair . 0.75 and above = excellent
        }

    }

      alt_test{

        docker.enabled = true
        outputDir = "./results"

        params {
            //init
            input_data = "./input_data/input.csv"
            file_name = "alt_test"
            //replicate_zero  
            quantile = true // if false all missing values will be treated with replicate zero strategie
            //cv_icc
            cv_cutoff = 0.3  // set between 0.2 to 0.3
            icc_cutoff = 0.65  // 0.4 = poor , 0.4 - 0.75 = fair . 0.75 and above = excellent
        }

    }

}
